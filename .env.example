# Copy to .env and fill in. NEVER commit .env.
# Qloo hackathon credentials (key arrives by email after form approval)
QLOO_API_KEY=
# mock | live — flip to "live" once the key arrives. That is the one-line switch.
QLOO_MODE=mock
# Gemini API key for Nano Banana image generation (https://aistudio.google.com/)
GEMINI_API_KEY=
# MiniMax API key for image-01 generation (https://platform.minimaxi.com/ for China accounts)
MINIMAX_API_KEY=
# minimax | gemini — image generation backend (default minimax)
IMAGE_PROVIDER=minimax
# mock | live — image generation backend
IMAGE_MODE=mock
PORT=3000
